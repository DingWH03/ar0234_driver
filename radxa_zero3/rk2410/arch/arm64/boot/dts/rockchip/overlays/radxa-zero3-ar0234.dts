/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

/ {
    metadata {
        title = "Enable AR0234 ISP";
        compatible = "radxa,zero3";
        category = "camera";
        exclusive = "csi2_dphy0";
        description = "Enable AR0234 via ISP";
    };
};

&{/} {
    clk_cam_24m: external-camera-clock-24m {
		status = "okay";
        compatible = "fixed-clock";
        clock-frequency = <24000000>;
        clock-output-names = "clk_cam_24m";
        #clock-cells = <0>;
    };

    camera_pwdn_gpio: camera-pwdn-gpio {
		status = "okay";
        compatible = "regulator-fixed";
        regulator-name = "camera_pwdn_gpio";
        regulator-always-on;
        regulator-boot-on;
        enable-active-high;
        gpio = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
    };
};

&i2c2 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2m1_xfer>;

    camera_ar0234: camera-ar0234@10 {
		status = "okay";
        compatible = "onnn,ar0234cs";
        reg = <0x10>;
        clocks = <&clk_cam_24m>;
        clock-names = "xvclk";
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "ar0234";
        sensor-type = <1>;   /* 1 = Monochrome, 黑白 */
        camera_pwdn_gpio-supply = <&camera_pwdn_gpio>;
        rockchip,camera-module-lens-name = "default";

        port {
            ucam_out0: endpoint {
                remote-endpoint = <&mipi_in_ucam0>;
                data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <450000000>;
            };
        };
    };
};

&csi2_dphy_hw {
    status = "okay";
};

&csi2_dphy0 {
    status = "okay";

    ports {
        #address-cells = <1>;
        #size-cells = <0>;

        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_in_ucam0: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&ucam_out0>;
                data-lanes = <1 2 3 4>;
				rockchip,ths-settle-offset = <15>;
            };
        };

        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;

            dphy0_out: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&isp0_in>;
            };
        };
    };
};

&rkisp {
    status = "okay";
};

&rkisp_mmu {
    status = "okay";
};

&rkisp_vir0 {
    status = "okay";

    port {
        #address-cells = <1>;
        #size-cells = <0>;

        isp0_in: endpoint@0 {
            reg = <0>;
            remote-endpoint = <&dphy0_out>;
        };
    };
};

&rkcif_mmu {
	status = "okay";
};

&rkcif {
	status = "okay";
};
